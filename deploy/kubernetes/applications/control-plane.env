# Non-secret configuration shared by every control-plane service.
#
# Two rules govern what may appear in this file, and both are load-bearing:
#
# 1. No secret values, ever. Credentials reach a pod by `secretKeyRef` or by a mounted file, and
#    the Secrets themselves are generated in-cluster by CloudNativePG and Strimzi. This repository
#    holds their names and nothing else.
# 2. No endpoint that could reach real hardware. `PROVIDER_ADAPTER` is absent, which the provider
#    factory reads as `fake`. Selecting a live hypervisor has to be a deliberate, separately
#    reviewed act, not an inherited default.
#
# WHY this is a generated ConfigMap in the applications layer rather than a plain one beside the
# namespace: kustomize gives a generated ConfigMap a name that includes a hash of its content and
# rewrites every reference to it. That turns a configuration change into a new Rollout revision,
# which means configuration goes through the same blue-green promotion gate that an image change
# does. A plain ConfigMap would change under the running pods and take effect at the next restart,
# whenever that happened to be, with nothing measuring the result.

NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=kubernetes-local

# Telemetry. The Collector runs in this namespace; see `observability/`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.private-cloud.svc.cluster.local:4317
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_METRIC_EXPORT_TIMEOUT=4000
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=always_on

# Per-pod scrape endpoint. This is what makes a blue-green promotion measurable: Prometheus
# scrapes each pod individually, so the green ReplicaSet's HTTP results can be read on their own
# instead of averaged with the blue one's.
PROMETHEUS_METRICS_PORT=9464

# Kafka. The bootstrap address is Strimzi's TLS listener; the settings beside it are references to
# Secrets Strimzi generates, and the password is read from a file rather than an environment
# variable so it never appears in a pod spec or an environment dump.
KAFKA_BROKERS=control-plane-kafka-kafka-bootstrap.private-cloud.svc.cluster.local:9093
KAFKA_HANDLER_MAX_ATTEMPTS=3
KAFKA_TLS_CA_FILE=/etc/private-cloud/kafka/ca.crt
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=control-plane
KAFKA_SASL_PASSWORD_FILE=/etc/private-cloud/kafka/password

# Identity provider. The local fixture issuer, which exists only inside this namespace.
OIDC_ISSUER=http://local-oidc.private-cloud.svc.cluster.local:18080
OIDC_AUDIENCE=private-cloud-control-plane
OIDC_JWKS_URI=http://local-oidc.private-cloud.svc.cluster.local:18080/.well-known/jwks.json

# Internal gRPC.
PROVIDER_GRPC_URL=proxmox-provider.private-cloud.svc.cluster.local:50052
PROVIDER_GRPC_DEADLINE_MS=10000
PROVIDER_ADDRESS=proxmox-provider.private-cloud.svc.cluster.local:50052
