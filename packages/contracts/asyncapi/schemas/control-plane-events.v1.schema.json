{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.private-cloud.invalid/events/control-plane-events.v1.schema.json",
  "title": "ControlPlaneEventV1",
  "oneOf": [
    { "$ref": "#/$defs/InstanceCreateRequested" },
    { "$ref": "#/$defs/InstancePowerRequested" },
    { "$ref": "#/$defs/InstanceResizeRequested" },
    { "$ref": "#/$defs/SnapshotCreateRequested" },
    { "$ref": "#/$defs/SnapshotRollbackRequested" },
    { "$ref": "#/$defs/SnapshotDeleteRequested" },
    { "$ref": "#/$defs/InstanceRetentionRequested" },
    { "$ref": "#/$defs/InstancePurgeRequested" },
    { "$ref": "#/$defs/ReconciliationRequested" },
    { "$ref": "#/$defs/ProvisioningReplayRequested" },
    { "$ref": "#/$defs/WorkflowProgressed" },
    { "$ref": "#/$defs/InstanceMutationCompleted" },
    { "$ref": "#/$defs/InstanceMutationFailed" },
    { "$ref": "#/$defs/InstanceObserved" },
    { "$ref": "#/$defs/DriftDetected" },
    { "$ref": "#/$defs/UnknownOutcomeResolved" },
    { "$ref": "#/$defs/ManualReviewCreated" },
    { "$ref": "#/$defs/ProvisioningDeadLettered" },
    { "$ref": "#/$defs/AuditRecorded" }
  ],
  "$defs": {
    "TraceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceparent"],
      "properties": {
        "traceparent": {
          "type": "string",
          "maxLength": 55,
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "tracestate": { "type": "string", "maxLength": 512 }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "required": [
        "eventId",
        "schemaName",
        "schemaVersion",
        "aggregateType",
        "aggregateId",
        "projectId",
        "operationId",
        "correlationId",
        "causationId",
        "occurredAt",
        "traceContext",
        "partitionKey"
      ],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "schemaName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "aggregateType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "aggregateId": { "type": "string", "format": "uuid" },
        "projectId": { "type": "string", "format": "uuid" },
        "operationId": { "type": "string", "format": "uuid" },
        "correlationId": { "type": "string", "format": "uuid" },
        "causationId": { "type": "string", "format": "uuid" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "traceContext": { "$ref": "#/$defs/TraceContext" },
        "partitionKey": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "Ipv4Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "prefixLength", "gateway", "dnsServers"],
      "properties": {
        "address": {
          "type": "string",
          "format": "ipv4",
          "x-classification": "tenant-configuration",
          "x-telemetry": "prohibited"
        },
        "prefixLength": { "type": "integer", "minimum": 1, "maximum": 32 },
        "gateway": { "type": "string", "format": "ipv4", "x-telemetry": "prohibited" },
        "dnsServers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "format": "ipv4" }
        }
      }
    },
    "Resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuCount", "memoryMiB", "diskGiB"],
      "properties": {
        "cpuCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memoryMiB": { "type": "integer", "minimum": 512, "maximum": 262144 },
        "diskGiB": { "type": "integer", "minimum": 8, "maximum": 2048 }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "safeMessage"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "validation",
            "authorization",
            "conflict",
            "transient",
            "permanent",
            "unknown_outcome",
            "compensation_failure",
            "manual_review"
          ]
        },
        "code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "safeMessage": { "type": "string", "maxLength": 512, "x-classification": "tenant-safe" },
        "retryAfterMilliseconds": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "InstanceCreateRequested": {
      "title": "InstanceCreateRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.create.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "imageId",
                "flavorId",
                "networkId",
                "hostname",
                "resources",
                "ipv4",
                "providerProfileId"
              ],
              "properties": {
                "imageId": { "type": "string", "minLength": 1, "maxLength": 63 },
                "flavorId": { "type": "string", "minLength": 1, "maxLength": 63 },
                "networkId": { "type": "string", "minLength": 1, "maxLength": 63 },
                "providerProfileId": { "type": "string", "minLength": 1, "maxLength": 63 },
                "hostname": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "x-classification": "tenant-configuration"
                },
                "resources": { "$ref": "#/$defs/Resources" },
                "ipv4": { "$ref": "#/$defs/Ipv4Configuration" },
                "sshPublicKeys": {
                  "type": "array",
                  "maxItems": 5,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 32, "maxLength": 8192 },
                  "x-classification": "tenant-configuration",
                  "x-telemetry": "prohibited"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstancePowerRequested": {
      "title": "InstancePowerRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.power.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action"],
              "properties": {
                "action": { "type": "string", "enum": ["start", "shutdown", "stop", "reboot"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstanceResizeRequested": {
      "title": "InstanceResizeRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.resize.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["flavorId", "targetResources"],
              "properties": {
                "flavorId": { "type": "string", "minLength": 1, "maxLength": 63 },
                "targetResources": { "$ref": "#/$defs/Resources" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SnapshotCreateRequested": {
      "title": "SnapshotCreateRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "snapshot.create.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId", "name"],
              "properties": {
                "snapshotId": { "type": "string", "format": "uuid" },
                "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                "description": {
                  "type": "string",
                  "maxLength": 256,
                  "x-classification": "tenant-configuration",
                  "x-telemetry": "prohibited"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SnapshotRollbackRequested": {
      "title": "SnapshotRollbackRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "snapshot.rollback.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId"],
              "properties": { "snapshotId": { "type": "string", "format": "uuid" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SnapshotDeleteRequested": {
      "title": "SnapshotDeleteRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "snapshot.delete.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId"],
              "properties": { "snapshotId": { "type": "string", "format": "uuid" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstanceRetentionRequested": {
      "title": "InstanceRetentionRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.retention.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["retentionDeadline", "leaseReleaseMode"],
              "properties": {
                "retentionDeadline": { "type": "string", "format": "date-time" },
                "leaseReleaseMode": {
                  "type": "string",
                  "enum": ["quarantine_until_purge", "release_on_retain"]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstancePurgeRequested": {
      "title": "InstancePurgeRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.purge.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["purgeAuthorizationId", "retentionDeadline", "reasonReference"],
              "properties": {
                "purgeAuthorizationId": { "type": "string", "format": "uuid" },
                "retentionDeadline": { "type": "string", "format": "date-time" },
                "reasonReference": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ReconciliationRequested": {
      "title": "ReconciliationRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "reconciliation.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reasonReference"],
              "properties": { "reasonReference": { "type": "string", "format": "uuid" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ProvisioningReplayRequested": {
      "title": "ProvisioningReplayRequestedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "provisioning.replay.requested" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["replayRequestId", "originalEventId", "requestedAt"],
              "properties": {
                "replayRequestId": { "type": "string", "format": "uuid" },
                "originalEventId": { "type": "string", "format": "uuid" },
                "requestedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "WorkflowProgressed": {
      "title": "WorkflowProgressedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "workflow.progressed" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "attempt", "operationState"],
              "properties": {
                "stage": { "type": "string", "minLength": 1, "maxLength": 80 },
                "attempt": { "type": "integer", "minimum": 1 },
                "operationState": {
                  "type": "string",
                  "enum": ["running", "retry_wait", "compensating", "unknown_outcome"]
                },
                "providerTaskReference": {
                  "type": "string",
                  "maxLength": 256,
                  "x-classification": "restricted-operational",
                  "x-telemetry": "bounded"
                },
                "nextActionAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstanceMutationCompleted": {
      "title": "InstanceMutationCompletedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.mutation.completed" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "lifecycleState", "evidenceId"],
              "properties": {
                "action": { "type": "string", "minLength": 1, "maxLength": 64 },
                "lifecycleState": { "type": "string", "minLength": 1, "maxLength": 64 },
                "providerResourceId": {
                  "type": "string",
                  "maxLength": 128,
                  "x-classification": "restricted-operational",
                  "x-telemetry": "prohibited"
                },
                "evidenceId": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstanceMutationFailed": {
      "title": "InstanceMutationFailedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.mutation.failed" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "failure", "compensationState"],
              "properties": {
                "action": { "type": "string", "minLength": 1, "maxLength": 64 },
                "failure": { "$ref": "#/$defs/Failure" },
                "compensationState": {
                  "type": "string",
                  "enum": ["not_required", "pending", "succeeded", "failed", "unsafe"]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InstanceObserved": {
      "title": "InstanceObservedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "instance.observed" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["exists", "powerState", "markerMatch", "observedAt", "evidenceId"],
              "properties": {
                "exists": { "type": "boolean" },
                "powerState": {
                  "type": "string",
                  "enum": ["running", "stopped", "suspended", "unknown"]
                },
                "resources": { "$ref": "#/$defs/Resources" },
                "markerMatch": { "type": "boolean" },
                "observedAt": { "type": "string", "format": "date-time" },
                "evidenceId": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DriftDetected": {
      "title": "DriftDetectedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "drift.detected" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["classification", "dangerous", "evidenceId"],
              "properties": {
                "classification": {
                  "type": "string",
                  "enum": [
                    "missing_resource",
                    "identity_mismatch",
                    "stale_task",
                    "late_success",
                    "power_drift",
                    "network_drift",
                    "ambiguous"
                  ]
                },
                "dangerous": { "type": "boolean" },
                "evidenceId": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "UnknownOutcomeResolved": {
      "title": "UnknownOutcomeResolvedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "unknown_outcome.resolved" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resolution", "ownershipProven", "evidenceId"],
              "properties": {
                "resolution": {
                  "type": "string",
                  "enum": ["succeeded", "failed", "manual_review"]
                },
                "ownershipProven": { "type": "boolean" },
                "evidenceId": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ManualReviewCreated": {
      "title": "ManualReviewCreatedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "manual_review.created" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reviewId", "category", "summary", "evidenceId"],
              "properties": {
                "reviewId": { "type": "string", "format": "uuid" },
                "category": {
                  "type": "string",
                  "enum": [
                    "unknown_outcome",
                    "identity_mismatch",
                    "ambiguous_drift",
                    "purge_guard",
                    "compensation_failure"
                  ]
                },
                "summary": {
                  "type": "string",
                  "maxLength": 512,
                  "x-classification": "restricted-operational"
                },
                "evidenceId": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ProvisioningDeadLettered": {
      "title": "ProvisioningDeadLetteredV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "provisioning.dead_lettered" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "instance" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "originalEventId",
                "originalSchemaName",
                "failure",
                "attempts",
                "deadLetteredAt"
              ],
              "properties": {
                "originalEventId": { "type": "string", "format": "uuid" },
                "originalSchemaName": { "type": "string", "minLength": 1, "maxLength": 120 },
                "failure": { "$ref": "#/$defs/Failure" },
                "attempts": { "type": "integer", "minimum": 1 },
                "deadLetteredAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "AuditRecorded": {
      "title": "AuditRecordedV1",
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "schemaName": { "const": "audit.recorded" },
            "schemaVersion": { "const": 1 },
            "aggregateType": { "const": "audit" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actorId", "actorRole", "action", "targetType", "targetId", "outcome"],
              "properties": {
                "actorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "x-classification": "audit",
                  "x-telemetry": "prohibited"
                },
                "actorRole": {
                  "type": "string",
                  "enum": [
                    "tenant_developer",
                    "platform_operator",
                    "platform_administrator",
                    "service"
                  ]
                },
                "action": { "type": "string", "minLength": 1, "maxLength": 80 },
                "targetType": { "type": "string", "minLength": 1, "maxLength": 80 },
                "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
                "outcome": {
                  "type": "string",
                  "enum": ["accepted", "succeeded", "rejected", "failed"]
                },
                "reasonReference": {
                  "type": "string",
                  "format": "uuid",
                  "x-classification": "audit",
                  "x-telemetry": "prohibited"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "x-max-payload-bytes": 262144,
  "x-compatibility": "Consumers reject unsupported major versions and tolerate additive optional fields within v1."
}
