{
  "name": "@private-cloud/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "private-cloud-control-plane": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./control-plane": {
      "private-cloud-control-plane": "./src/generated/proto/privatecloud/controlplane/v1/control_plane.pb.ts",
      "types": "./dist/generated/proto/privatecloud/controlplane/v1/control_plane.pb.d.ts",
      "import": "./dist/generated/proto/privatecloud/controlplane/v1/control_plane.pb.js",
      "default": "./dist/generated/proto/privatecloud/controlplane/v1/control_plane.pb.js"
    },
    "./provider": {
      "private-cloud-control-plane": "./src/generated/proto/privatecloud/provider/v1/provider.pb.ts",
      "types": "./dist/generated/proto/privatecloud/provider/v1/provider.pb.d.ts",
      "import": "./dist/generated/proto/privatecloud/provider/v1/provider.pb.js",
      "default": "./dist/generated/proto/privatecloud/provider/v1/provider.pb.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
