vars: {
  d2-config: {
    theme-id: 0
    pad: 40
  }
}

sequence: Provider Timeout and Unknown Outcome {
  shape: sequence_diagram
  style.fill: "#FFFFFF"
  style.stroke: "#667085"
  style.stroke-width: 2

  orchestrator: Orchestrator {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
  }
  db: PostgreSQL {
    style.fill: "#E8F0FE"
    style.stroke: "#3568B8"
  }
  provider: Proxmox Provider {
    style.fill: "#FFE3E3"
    style.stroke: "#B42318"
  }
  pve: Proxmox VE {
    style.fill: "#FFF0E1"
    style.stroke: "#C45B14"
  }
  reconciler: Reconciler {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
  }
  sre: SRE {
    style.fill: "#FFF7D6"
    style.stroke: "#B7791F"
  }

  timeout: Submission result becomes unknown {
    style.fill: "#FFF6F6"
    style.stroke: "#D66A6A"
    orchestrator -> db: persist pre-provider checkpoint
    orchestrator -> provider: submit create
    provider -> pve: submit full clone
    pve -> provider: response lost after possible acceptance {
      style.stroke: "#B42318"
      style.stroke-dash: 6
    }
    provider -> orchestrator: unknown outcome + correlation facts
    orchestrator -> db: persist unknown + stop automatic create retry
  }

  observe: Reconcile with live evidence {
    style.fill: "#F8FAFC"
    style.stroke: "#98A2B3"
    reconciler -> provider: query allowed VMID range + ownership markers
    provider -> pve: read matching resources + tasks
  }

  success: Alt - exactly one owned VM proves success {
    style.fill: "#F5FBF3"
    style.stroke: "#5A9E56"
    pve -> provider: owned VM + task state
    provider -> reconciler: verified late success
    reconciler -> db: complete operation + observed state
  }

  inconclusive: Else - evidence remains missing or ambiguous {
    style.fill: "#FFFBEA"
    style.stroke: "#D9B44A"
    pve -> provider: missing or ambiguous evidence
    provider -> reconciler: inconclusive result
    reconciler -> db: create manual-review item
    sre -> db: record authorized investigation + resolution
  }
}
