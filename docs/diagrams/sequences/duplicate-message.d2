vars: {
  d2-config: {
    theme-id: 0
    pad: 40
  }
}

sequence: Duplicate Kafka Message {
  shape: sequence_diagram
  style.fill: "#FFFFFF"
  style.stroke: "#667085"
  style.stroke-width: 2

  kafka: Kafka {
    style.fill: "#F3E8FF"
    style.stroke: "#7A3E9D"
  }
  orchestrator: Orchestrator {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
  }
  db: PostgreSQL {
    style.fill: "#E8F0FE"
    style.stroke: "#3568B8"
  }
  provider: Proxmox Provider {
    style.fill: "#FFE3E3"
    style.stroke: "#B42318"
  }

  first_delivery: First delivery executes once {
    style.fill: "#F2FCFA"
    style.stroke: "#66B7A9"
    kafka -> orchestrator: event E for instance I
    orchestrator -> db: insert inbox E + claim workflow lease I
    orchestrator -> provider: execute provider step once
    provider -> orchestrator: task reference + result
    orchestrator -> db: complete checkpoint + inbox E + result outbox
    orchestrator -> kafka: commit consumed offset
  }

  redelivery: Redelivery reuses durable outcome {
    style.fill: "#F5FBF3"
    style.stroke: "#5A9E56"
    kafka -> orchestrator: redeliver event E
    orchestrator -> db: read inbox receipt E
    db -> orchestrator: existing completed outcome
    orchestrator -> orchestrator: reuse outcome + skip side effects
    orchestrator -> kafka: commit duplicate offset
  }
}
