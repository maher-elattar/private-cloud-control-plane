vars: {
  d2-config: {
    theme-id: 0
    pad: 40
  }
}

sequence: Kafka Unavailable After Acceptance {
  shape: sequence_diagram
  style.fill: "#FFFFFF"
  style.stroke: "#667085"
  style.stroke-width: 2

  client: Client {
    style.fill: "#FFF7D6"
    style.stroke: "#B7791F"
  }
  api: Control API {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
  }
  db: PostgreSQL {
    style.fill: "#E8F0FE"
    style.stroke: "#3568B8"
  }
  cdc: Debezium {
    style.fill: "#F3F5F7"
    style.stroke: "#667085"
  }
  kafka: Kafka {
    style.fill: "#FFE3E3"
    style.stroke: "#B42318"
  }
  alerting: Alerting {
    style.fill: "#FFFBEA"
    style.stroke: "#B7791F"
  }
  orchestrator: Orchestrator {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
  }

  accepted: Committed while broker is unavailable {
    style.fill: "#F2FCFA"
    style.stroke: "#66B7A9"
    client -> api: submit mutation + idempotency key
    api -> db: commit desired state + operation + idempotency + outbox
    api -> client: 202 + operation ID
    cdc -> db: read committed outbox
    cdc -> kafka: publication unavailable {
      style.stroke: "#B42318"
      style.stroke-dash: 6
    }
    cdc -> cdc: retain offset + retry
  }

  degraded: Durable degraded operation {
    style.fill: "#FFFBEA"
    style.stroke: "#D9B44A"
    alerting -> db: observe old outbox age
    alerting -> client: operator alert active
    client -> api: GET operation
    api -> client: accepted + awaiting publication
  }

  recovery: Broker recovery {
    style.fill: "#F5FBF3"
    style.stroke: "#5A9E56"
    kafka -> cdc: broker available
    cdc -> kafka: publish original event ID
    kafka -> orchestrator: deliver command
    orchestrator -> db: claim inbox + continue workflow
  }
}
