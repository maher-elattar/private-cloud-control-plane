vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 48
  }
}

direction: down

classes: {
  client: {
    style.fill: "#FFF7D6"
    style.stroke: "#B7791F"
    style.stroke-width: 2
    style.shadow: true
  }
  app: {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
    style.stroke-width: 2
    style.shadow: true
  }
  privileged: {
    style.fill: "#FFE3E3"
    style.stroke: "#B42318"
    style.stroke-width: 3
    style.shadow: true
  }
  data: {
    shape: cylinder
    style.fill: "#E8F0FE"
    style.stroke: "#3568B8"
    style.stroke-width: 2
  }
  messaging: {
    shape: queue
    style.fill: "#F3E8FF"
    style.stroke: "#7A3E9D"
    style.stroke-width: 2
  }
  platform: {
    style.fill: "#F3F5F7"
    style.stroke: "#667085"
    style.stroke-width: 2
  }
  aws: {
    style.fill: "#FFF0E1"
    style.stroke: "#C45B14"
    style.stroke-width: 2
    style.shadow: true
  }
  telemetry: {
    style.fill: "#EAF7E8"
    style.stroke: "#3B7D3A"
    style.stroke-width: 2
  }
}

clients: Clients {
  direction: right
  style.fill: "#FFFCF2"
  style.stroke: "#D9B44A"

  cli: CLI or API Client {
    class: client
    icon: https://icons.terrastruct.com/essentials/365-user.svg
  }
  operator: Operator Workflow {
    class: client
    icon: https://icons.terrastruct.com/essentials/365-user.svg
  }
}

gateway: Existing Gateway API + TLS {
  shape: hexagon
  style.fill: "#E8F0FE"
  style.stroke: "#3568B8"
  style.stroke-width: 2
}

kubernetes: Kubernetes Control Plane Runtime {
  direction: down
  style.fill: "#F7FBFF"
  style.stroke: "#3568B8"
  style.stroke-width: 3

  applications: Four Application Deployables {
    direction: right
    style.fill: "#F2FCFA"
    style.stroke: "#66B7A9"

    api: Control API\nNestJS REST\nCatalog + desired state\nOperations + projections {
      class: app
    }
    orchestrator: Provisioning Orchestrator\nNestJS Kafka consumer\nInbox + leases + checkpoints\nRetries + compensation {
      class: app
    }
    provider: Proxmox Provider\nNestJS gRPC adapter\nTranslation + ownership\nTask submission + polling {
      class: privileged
    }
    reconciler: Reconciler\nScheduled observation\nDrift + late-outcome\nclassification {
      class: app
    }
  }

  data_plane: Data and Messaging {
    direction: right
    style.fill: "#F8FAFC"
    style.stroke: "#98A2B3"

    postgres: PostgreSQL\nDomain + workflow state {
      class: data
    }
    debezium: Debezium\nOutbox CDC {
      class: platform
      shape: hexagon
    }
    kafka: Kafka\nCommands, events, audit, DLQ {
      class: messaging
    }
    keda: KEDA\nLag-based scaling {
      class: platform
      shape: hexagon
    }
  }

  otel: OpenTelemetry Collector {
    class: telemetry
    shape: hexagon
  }
}

provider_boundary: Provider Management Boundary {
  style.fill: "#FFF6F6"
  style.stroke: "#B42318"
  style.stroke-width: 3

  pve: Proxmox VE API {
    shape: cloud
    style.fill: "#FFE3E3"
    style.stroke: "#B42318"
    style.stroke-width: 2
  }
}

observability: Observability Backends {
  direction: down
  style.fill: "#F5FBF3"
  style.stroke: "#5A9E56"

  prometheus: Prometheus {
    class: data
  }
  tempo: Tempo {
    class: data
  }
  loki: Loki {
    class: data
  }
  grafana: Grafana {
    class: telemetry
  }
}

aws: Bounded AWS Reference Slice {
  direction: down
  style.fill: "#FFF8F0"
  style.stroke: "#C45B14"
  style.stroke-width: 3

  api_gateway: API Gateway {
    class: aws
    icon: https://icons.terrastruct.com/aws/Networking%20&%20Content%20Delivery/Amazon-API-Gateway.svg
  }
  command_lambda: Command Lambda {
    class: aws
    icon: https://icons.terrastruct.com/aws/Compute/AWS-Lambda.svg
  }
  dynamodb: DynamoDB\nAggregate + outbox items {
    class: data
    icon: https://icons.terrastruct.com/aws/Database/Amazon-DynamoDB.svg
  }
  relay_lambda: Streams Relay Lambda {
    class: aws
    icon: https://icons.terrastruct.com/aws/Compute/AWS-Lambda.svg
  }
  sqs: SQS FIFO + DLQ {
    class: messaging
  }
  watchdog: EventBridge Scheduler\n+ Watchdog Lambda {
    class: aws
    icon: https://icons.terrastruct.com/aws/Compute/AWS-Lambda.svg
  }
  archive: S3 Audit Archive {
    class: aws
    shape: cylinder
    icon: https://icons.terrastruct.com/aws/Storage/Amazon-Simple-Storage-Service-S3.svg
  }
  cloudwatch: CloudWatch {
    class: aws
    icon: https://icons.terrastruct.com/aws/Management%20&%20Governance/Amazon-CloudWatch.svg
  }
}

clients.cli -> gateway: HTTPS
clients.operator -> gateway: HTTPS
gateway -> kubernetes.applications.api: REST

kubernetes.applications.api -> kubernetes.data_plane.postgres: accept
kubernetes.data_plane.postgres -> kubernetes.data_plane.debezium: WAL
kubernetes.data_plane.debezium -> kubernetes.data_plane.kafka: outbox
kubernetes.data_plane.kafka -> kubernetes.applications.orchestrator: commands
kubernetes.applications.orchestrator -> kubernetes.data_plane.postgres: checkpoint
kubernetes.applications.orchestrator -> kubernetes.applications.provider: mutate gRPC
kubernetes.applications.reconciler -> kubernetes.applications.provider: observe gRPC
kubernetes.applications.reconciler -> kubernetes.data_plane.postgres: observe
kubernetes.applications.reconciler -> kubernetes.data_plane.kafka: drift event
kubernetes.data_plane.kafka -> kubernetes.applications.api: project
kubernetes.data_plane.keda -> kubernetes.applications.orchestrator: scale from lag
kubernetes.applications.provider -> provider_boundary.pve: allowlisted API calls {
  style.stroke: "#B42318"
  style.stroke-width: 3
}

kubernetes.applications.api -> kubernetes.otel
kubernetes.applications.orchestrator -> kubernetes.otel
kubernetes.applications.provider -> kubernetes.otel
kubernetes.applications.reconciler -> kubernetes.otel
kubernetes.otel -> observability.prometheus: metrics
kubernetes.otel -> observability.tempo: traces
kubernetes.otel -> observability.loki: logs
observability.prometheus -> observability.grafana: query
observability.tempo -> observability.grafana: query
observability.loki -> observability.grafana: query

clients.cli -> aws.api_gateway: HTTPS
aws.api_gateway -> aws.command_lambda: invoke
aws.command_lambda -> aws.dynamodb: transact accept
aws.dynamodb -> aws.relay_lambda: stream records
aws.relay_lambda -> aws.sqs: ordered command
aws.watchdog -> aws.dynamodb: conditional timeout
aws.relay_lambda -> aws.archive: append audit
aws.command_lambda -> aws.cloudwatch
aws.relay_lambda -> aws.cloudwatch
aws.watchdog -> aws.cloudwatch
