vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 48
  }
}

direction: down

classes: {
  actor: {
    shape: person
    style.fill: "#FFF7D6"
    style.stroke: "#B7791F"
    style.stroke-width: 2
    style.shadow: true
  }
  primary: {
    shape: hexagon
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
    style.stroke-width: 3
    style.shadow: true
    style.bold: true
  }
  external: {
    style.fill: "#F3F5F7"
    style.stroke: "#667085"
    style.stroke-width: 2
    style.shadow: true
  }
  platform: {
    style.fill: "#E8F0FE"
    style.stroke: "#3568B8"
    style.stroke-width: 2
    style.shadow: true
  }
  cloud: {
    style.fill: "#FFF0E1"
    style.stroke: "#C45B14"
    style.stroke-width: 2
    style.shadow: true
  }
}

people: People {
  direction: right
  style.fill: "#FFFCF2"
  style.stroke: "#D9B44A"
  style.stroke-width: 2

  tenant: Tenant Developer {
    class: actor
    icon: https://icons.terrastruct.com/essentials/365-user.svg
  }
  admin: Platform Administrator {
    class: actor
    icon: https://icons.terrastruct.com/essentials/365-user.svg
  }
  sre: Site Reliability Engineer {
    class: actor
    icon: https://icons.terrastruct.com/essentials/365-user.svg
  }
}

control_plane: Private Cloud Control Plane\nProvider-neutral VM commands\nDurable workflows + reconciliation\nOperational evidence {
  class: primary
  width: 360
  height: 170
}

external_systems: External Systems {
  direction: right
  style.fill: "#F8FAFC"
  style.stroke: "#98A2B3"
  style.stroke-width: 2

  identity: Identity Provider {
    class: external
    shape: hexagon
  }
  foundation: Kubernetes Foundation {
    class: platform
    icon: https://icons.terrastruct.com/infra/019-network.svg
  }
  proxmox: Proxmox VE {
    class: external
    shape: cloud
  }
  delivery: Live GitOps Repository {
    class: external
    shape: document
  }
  aws: AWS Sandbox {
    class: cloud
    icon: https://icons.terrastruct.com/aws/Compute/AWS-Lambda.svg
  }
}

people.tenant -> control_plane: REST commands and queries {
  style.stroke: "#087F6A"
  style.stroke-width: 2
}
people.admin -> control_plane: catalog, recovery, retention, purge {
  style.stroke: "#087F6A"
  style.stroke-width: 2
}
people.sre -> control_plane: diagnosis, replay, drift review {
  style.stroke: "#087F6A"
  style.stroke-width: 2
}

control_plane -> external_systems.identity: auth claims
external_systems.foundation -> control_plane: runs workloads
control_plane -> external_systems.proxmox: VM operations
external_systems.delivery -> external_systems.foundation: desired state + image digests
control_plane -> external_systems.aws: reference commands {
  style.stroke: "#C45B14"
  style.stroke-width: 2
}
