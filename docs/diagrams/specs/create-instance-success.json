{
  "title": "Create Instance - Success",
  "participants": [
    {"id": "tenant", "label": "Tenant Developer", "actor": true},
    {"id": "gateway", "label": "Gateway API"},
    {"id": "api", "label": "Control API"},
    {"id": "db", "label": "PostgreSQL"},
    {"id": "cdc", "label": "Debezium"},
    {"id": "kafka", "label": "Kafka"},
    {"id": "orch", "label": "Provisioning Orchestrator"},
    {"id": "provider", "label": "Proxmox Provider"},
    {"id": "pve", "label": "Proxmox VE"}
  ],
  "messages": [
    {"from": "tenant", "to": "gateway", "label": "POST /instances [idempotency key]", "activate": false},
    {"from": "gateway", "to": "api", "label": "Authenticated request + trace context"},
    {"from": "api", "to": "api", "label": "Authorize project; validate catalog + quota"},
    {"from": "api", "to": "db", "label": "BEGIN"},
    {"from": "api", "to": "db", "label": "Insert idempotency, instance, operation, lease + outbox"},
    {"from": "db", "to": "api", "label": "COMMIT durable intent", "return": true},
    {"from": "api", "to": "tenant", "label": "202 Accepted [instance ID, operation ID]", "return": true},
    {"from": "cdc", "to": "db", "label": "Read committed outbox change", "activate": false},
    {"from": "cdc", "to": "kafka", "label": "CreateInstance [key: instance ID]", "async": true, "activate": false},
    {"from": "kafka", "to": "orch", "label": "Deliver CreateInstance", "async": true, "activate": false},
    {"from": "orch", "to": "db", "label": "Claim inbox + workflow lease", "activate": false},
    {"from": "orch", "to": "db", "label": "Persist pre-provider checkpoint", "activate": false},
    {"from": "orch", "to": "provider", "label": "Create VM [provider-neutral request]"},
    {"from": "provider", "to": "pve", "label": "Submit full clone [allowlisted values]"},
    {"from": "pve", "to": "provider", "label": "Provider task reference", "return": true},
    {"from": "provider", "to": "orch", "label": "Accepted task reference", "return": true},
    {"from": "orch", "to": "db", "label": "Persist task reference before polling", "activate": false},
    {"note": "LOOP: until task stops or deadline is reached", "over": "orch"},
    {"from": "orch", "to": "provider", "label": "Read provider task status"},
    {"from": "provider", "to": "pve", "label": "Read task status + bounded progress"},
    {"from": "pve", "to": "provider", "label": "Running progress", "return": true},
    {"from": "provider", "to": "orch", "label": "Normalized task state", "return": true},
    {"from": "orch", "to": "db", "label": "Update checkpoint + operation progress", "activate": false},
    {"from": "orch", "to": "provider", "label": "Apply owned VM configuration"},
    {"from": "provider", "to": "pve", "label": "Configure compute, network, cloud-init + markers"},
    {"from": "pve", "to": "provider", "label": "Successful task outcome", "return": true},
    {"from": "provider", "to": "orch", "label": "Normalized success", "return": true},
    {"from": "orch", "to": "provider", "label": "Observe VM identity + state"},
    {"from": "provider", "to": "pve", "label": "Read VM config + status"},
    {"from": "pve", "to": "provider", "label": "Matching owned VM observation", "return": true},
    {"from": "provider", "to": "orch", "label": "Verified observed state", "return": true},
    {"from": "orch", "to": "db", "label": "Commit observed state, completion, inbox + event outbox", "activate": false},
    {"from": "cdc", "to": "db", "label": "Read committed event outbox", "activate": false},
    {"from": "cdc", "to": "kafka", "label": "Append instance + operation events", "async": true, "activate": false},
    {"from": "kafka", "to": "api", "label": "Deliver projection events", "async": true, "activate": false},
    {"from": "api", "to": "db", "label": "Update idempotent read projections", "activate": false},
    {"from": "tenant", "to": "api", "label": "GET operation or instance"},
    {"from": "api", "to": "tenant", "label": "Succeeded operation + active instance", "return": true}
  ]
}
