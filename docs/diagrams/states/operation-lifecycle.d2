vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 48
  }
}

direction: right

classes: {
  start: {
    shape: circle
    style.fill: "#344054"
    style.stroke: "#1D2939"
    style.stroke-width: 2
  }
  pending: {
    style.fill: "#E8F0FE"
    style.stroke: "#3568B8"
    style.stroke-width: 2
    style.shadow: true
  }
  running: {
    style.fill: "#DDF7F3"
    style.stroke: "#087F6A"
    style.stroke-width: 3
    style.shadow: true
  }
  retry: {
    style.fill: "#F3E8FF"
    style.stroke: "#7A3E9D"
    style.stroke-width: 2
  }
  failed: {
    style.fill: "#FFE3E3"
    style.stroke: "#B42318"
    style.stroke-width: 2
  }
  review: {
    style.fill: "#FFF7D6"
    style.stroke: "#B7791F"
    style.stroke-width: 3
  }
  success: {
    style.fill: "#DFF3DF"
    style.stroke: "#2E7D32"
    style.stroke-width: 3
    style.shadow: true
  }
}

start: Start {class: start; width: 70; height: 70}
accepted: ACCEPTED {class: pending}
queued: QUEUED {class: pending}
running: RUNNING {class: running}
retry: RETRY SCHEDULED {class: retry}
compensating: COMPENSATING {class: retry}
dead_lettered: DEAD LETTERED {class: failed}
manual: MANUAL REVIEW {class: review}
succeeded: SUCCEEDED {class: success}
failed: FAILED {class: failed}
end: End {class: start; width: 70; height: 70}

start -> accepted: intent + outbox committed
accepted -> queued: command published
queued -> running: inbox + workflow lease claimed

running -> succeeded: intended result observed {
  style.stroke: "#2E7D32"
  style.stroke-width: 2
}
running -> retry: transient failure {
  style.stroke: "#7A3E9D"
}
retry -> running: retry due {
  style.stroke: "#7A3E9D"
  style.stroke-dash: 5
}
running -> compensating: partial permanent failure {
  style.stroke: "#7A3E9D"
}
compensating -> failed: compensation verified {
  style.stroke: "#B42318"
}
compensating -> manual: compensation failed or unknown {
  style.stroke: "#B7791F"
}
running -> failed: permanent failure before side effect {
  style.stroke: "#B42318"
}
running -> manual: provider outcome unknown {
  style.stroke: "#B7791F"
}
running -> dead_lettered: poison or exhausted processing {
  style.stroke: "#B42318"
}

dead_lettered -> queued: authorized replay {
  style.stroke: "#7A3E9D"
  style.stroke-dash: 5
}
manual -> running: authorized safe resume {
  style.stroke: "#7A3E9D"
  style.stroke-dash: 5
}
manual -> succeeded: observed success {
  style.stroke: "#2E7D32"
}
manual -> failed: observed failure or absence {
  style.stroke: "#B42318"
}

succeeded -> end
failed -> end
