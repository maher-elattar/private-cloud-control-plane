        <mxCell id="m0" value="Deliver event E [instance I]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.1286;entryX=0.5;entryY=0.1286;" edge="1" parent="1" source="kafka" target="orch">
          <mxGeometry relative="1" as="geometry"/>
