          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="Retain source offset + retry" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4;entryX=0.5;entryY=0.4353;" edge="1" parent="1" source="cdc" target="cdc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="750" y="380"/><mxPoint x="750" y="410"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="Observe old outbox age" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4824;entryX=1;entryY=0.403;" edge="1" parent="1" source="alert" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="Operator alert active" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.5412;entryX=0.5;entryY=0.5412;" edge="1" parent="1" source="alert" target="client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="Read operation" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6;entryX=0;entryY=0.0;" edge="1" parent="1" source="client" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="Accepted; awaiting publication" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.6588;" edge="1" parent="1" source="act1" target="client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="Broker recovers" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.7176;entryX=0.5;entryY=0.7176;" edge="1" parent="1" source="kafka" target="cdc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="Publish original event ID" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.7765;entryX=0.5;entryY=0.7765;" edge="1" parent="1" source="cdc" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="Deliver command" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.8353;entryX=0.5;entryY=0.8353;" edge="1" parent="1" source="kafka" target="orch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="Claim inbox + continue workflow" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8941;entryX=1;entryY=0.9254;" edge="1" parent="1" source="orch" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
