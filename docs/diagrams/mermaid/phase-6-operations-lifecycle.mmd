flowchart TD
  START(["Fresh machine"]) --> C1

  subgraph HOST["On the host, imperative and run by a person"]
    C1["minikube start<br/>cluster, Gateway, storage class"]
    C2["pnpm run k8s:build-images<br/>7 images into the node's Docker daemon"]
    C3["pnpm run k8s:bootstrap<br/>Argo CD, Argo Rollouts, gitops-repo,<br/>AppProject, root Application"]
    C4["pnpm run k8s:publish<br/>packs deploy/kubernetes into the<br/>in-cluster repository and syncs"]
    C1 --> C2 --> C3 --> C4
  end

  C4 --> R1

  subgraph CLUSTER["In the cluster, declarative and continuous"]
    R1["Argo CD reconciles waves 0 to 5"]
    R2["Rollouts promote through<br/>the analysis gate"]
    R3["Steady state:<br/>10 Applications Synced and Healthy"]
    R1 --> R2 --> R3
  end

  R3 --> V1

  subgraph VERIFY["Proving it works"]
    V1["pnpm run k8s:render-check<br/>161 objects, 8 policies"]
    V2["pnpm run verify:phase6-runtime<br/>12 deployment checks and drills"]
    V3["pnpm run postman:run<br/>62 API requests, full lifecycle"]
    V1 --> V2 --> V3
  end

  V3 --> D1

  subgraph DOWN["Coming down"]
    D1["minikube stop<br/>everything persists, nothing is lost"]
    D2["Argo CD prunes what<br/>the repository stops describing"]
    D3["minikube delete<br/>destroys the cluster and its images"]
    D1 -.-> D3
  end

  D2 -.-> R1

