flowchart LR
  subgraph Push["OTLP metric producers - 5 second interval"]
    Apps["Four Node.js services<br/>custom + HTTP/gRPC/PostgreSQL<br/>runtime + event-loop metrics"]
    KafkaJMX["Kafka JMX exporter<br/>broker + topic + partition metrics"]
    ConnectJMX["Connect JMX exporter<br/>worker + task + Debezium metrics"]
  end

  subgraph Pull["Collector-owned infrastructure collection"]
    Postgres["PostgreSQL receiver<br/>connections + transactions + locks"]
    Slots["SQL query receiver<br/>logical slot active + retained bytes"]
    Self["Collector self scrape<br/>accepted + refused + export failures"]
  end

  subgraph Collector["OpenTelemetry Collector metric pipeline"]
    OTLP["OTLP gRPC/HTTP receiver"]
    Infra["PostgreSQL + SQL + self receivers"]
    Guard["Memory limiter<br/>drop duplicate JVM series<br/>sanitize resource attributes"]
    Batch["Batch processor"]
    Export["Prometheus exporter :8889<br/>OpenMetrics + exemplars"]
  end

  Prometheus[("Prometheus<br/>one scrape target")]
  Grafana["Grafana<br/>five-panel event dashboard"]
  Tempo[("Tempo traces")]

  Apps & KafkaJMX & ConnectJMX -->|"push OTLP"| OTLP
  Postgres & Slots & Self --> Infra
  OTLP & Infra --> Guard
  Guard --> Batch --> Export
  Prometheus -->|"pull /metrics"| Export
  Prometheus --> Grafana
  Export -. "trace_id exemplars" .-> Tempo
  Tempo --> Grafana

  Cardinality["Enforced metric rules<br/>allowlisted labels<br/>128 series per custom instrument<br/>no tenant or resource IDs"]
  Cardinality -.-> Apps
  Cardinality -.-> Guard

