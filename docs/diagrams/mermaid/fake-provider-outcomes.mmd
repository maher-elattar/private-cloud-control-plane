flowchart LR
    Request["Provider RPC<br/>stable requestId"] --> Cache{"Known requestId?"}
    Cache -- "yes, same input" --> Cached["Return cached result<br/>no second mutation"]
    Cache -- "yes, changed input" --> Conflict["Protocol error<br/>non-retryable"]
    Cache -- no --> Step["Consume next deterministic<br/>scenario step"]

    Step --> Latency["Apply configured latency<br/>with abort support"]
    Latency --> Mode{"Scenario mode"}
    Mode -- success --> Apply["Apply one logical mutation<br/>and create task evidence"]
    Apply --> Accepted["ACCEPTED<br/>cache result"]

    Mode -- failure --> Rejected["REJECTED<br/>classified safe failure"]
    Rejected --> CacheFailure["Cache rejection"]

    Mode -- timeout --> Before{"Apply before<br/>response loss?"}
    Before -- no --> Deadline["Transport deadline<br/>no outcome claim"]
    Before -- yes --> AppliedTimeout["Apply once and cache success"]
    AppliedTimeout --> Deadline

    Mode -- unknown-outcome --> UnknownApply{"Apply before<br/>unknown result?"}
    UnknownApply -- optional --> AppliedUnknown["Apply once for later<br/>observation"]
    UnknownApply -- no --> Unknown["UNKNOWN outcome<br/>cache evidence"]
    AppliedUnknown --> Unknown

    Accepted --> Observe["Task polling and observation"]
    Deadline --> Observe
    Unknown --> Observe

    classDef safe fill:#dcfce7,stroke:#15803d,color:#14532d;
    classDef caution fill:#fef3c7,stroke:#b45309,color:#78350f;
    classDef failure fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d;
    class Accepted,Cached,Apply,Observe safe;
    class Deadline,Unknown,AppliedTimeout,AppliedUnknown caution;
    class Conflict,Rejected,CacheFailure failure;
