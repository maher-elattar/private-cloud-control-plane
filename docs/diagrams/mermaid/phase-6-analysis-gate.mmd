flowchart TD
  S["Green pods joined<br/>control-api-preview"] --> D0["initialDelay 45s<br/>at least two scrapes at 10s"]
  D0 --> M1{"green-scrape-health<br/>count(up == 1) >= 2 ?"}
  M1 -- no --> F["AnalysisRun Failed"]
  M1 -- yes --> M2{"green-traffic-floor<br/>request rate >= 0.10/s ?"}
  M2 -- no --> F
  M2 -- yes --> M3{"green-http-200-rate<br/>200s / all responses >= 0.90 ?"}
  M3 -- no --> F
  M3 -- yes --> C{"4 measurements taken<br/>at 20s intervals?"}
  C -- no --> D0
  C -- yes --> P["AnalysisRun Successful"]

  P --> PROM["Active service moves to green"]
  F --> AB["Rollout aborted<br/>active service unchanged"]
  AB --> SH["Self-healing:<br/>Argo CD keeps reconciling the desired spec,<br/>blue keeps serving, green is scaled down"]

  N1["failureLimit 1 - one bad measurement<br/>is noise, two is a verdict"] -.-> M3
  N2["clamp_min on the denominator -<br/>an empty vector must not read as<br/>a perfect success rate"] -.-> M3

  classDef gate fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e
  classDef bad fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d
  classDef good fill:#dcfce7,stroke:#15803d,color:#14532d
  classDef note fill:#fef9c3,stroke:#ca8a04,color:#713f12
  class M1,M2,M3,C gate
  class F,AB bad
  class P,PROM,SH good
  class N1,N2 note
