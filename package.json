{
  "name": "private-cloud-control-plane",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.3.0 <12"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "contracts:check": "pnpm run contracts:generate && pnpm run contracts:validate && pnpm run contracts:docs && git diff --exit-code -- packages/contracts/src/generated docs/contracts",
    "contracts:docs": "node tools/contracts/generate-docs.mjs",
    "contracts:generate": "node tools/contracts/generate.mjs",
    "contracts:validate": "node tools/contracts/validate.mjs",
    "db:migrate": "node tools/db/migrate.mjs",
    "db:seed": "node tools/db/seed.mjs",
    "docs:validate": "node tools/docs/validate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "k8s:build-images": "node tools/kubernetes/build-images.mjs",
    "k8s:bootstrap": "node tools/kubernetes/bootstrap.mjs",
    "k8s:publish": "node tools/kubernetes/publish-gitops-repo.mjs",
    "k8s:render-check": "node tools/kubernetes/render-check.mjs",
    "k8s:resync": "node tools/kubernetes/resync.mjs",
    "postman:check": "node tools/postman/run-collection.mjs --check",
    "postman:run": "node tools/postman/run-collection.mjs",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test && pnpm run test:tools",
    "test:integration": "nx run-many -t test-integration",
    "test:tools": "node --test \"tools/**/*.spec.mjs\"",
    "typecheck": "nx run-many -t typecheck",
    "verify:audit-topology": "nx run-many -t build --projects=application,postgres-adapter,provider-adapters && node tools/verification/verify-audit-topology.mjs",
    "verify:phase4-runtime": "node tools/verification/verify-phase4-runtime.mjs",
    "verify:phase6-runtime": "node tools/kubernetes/verify-phase6.mjs"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@bufbuild/buf": "1.72.0",
    "@eslint/js": "9.39.5",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@redocly/cli": "2.47.0",
    "@swc/helpers": "0.5.23",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.2.1",
    "json-schema-to-typescript": "15.0.4",
    "jsonc-eslint-parser": "2.4.2",
    "nx": "23.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "ts-proto": "2.12.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "5.2.6",
    "yaml": "2.9.0"
  }
}
