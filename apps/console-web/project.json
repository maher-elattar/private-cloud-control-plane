{
  "name": "console-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/console-web/src",
  "projectType": "application",
  "tags": ["type:app", "scope:console"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/console-web"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/console-web"
      }
    },
    "preview": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/console-web"
      }
    }
  }
}
